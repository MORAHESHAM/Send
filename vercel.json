{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "/(.*)\\.(html|css|js|png|jpg|ico)",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ]
}